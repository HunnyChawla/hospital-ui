# Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# For GitHub Pages deployment, these are set via GitHub Actions workflow

# Base path for GitHub Pages deployment
# Set to the repository name for GitHub Pages subdirectory deployment
NEXT_PUBLIC_BASE_PATH=/hospital-ui

# Production API Base URL
# Replace with your actual production API URL
# For GitHub Actions, set this as a GitHub Secret: NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_API_BASE_URL=https://hms-platform-backend.onrender.com

# Domain URL for subdomain detection (optional)
# If your production app uses subdomain-based routing, set this to your base domain
# Example: NEXT_PUBLIC_DOMAIN_URL=cura.com
# This will extract subdomain from URLs like demo-hospital.cura.com → demo-hospital
NEXT_PUBLIC_DOMAIN_URL=technesian.com
