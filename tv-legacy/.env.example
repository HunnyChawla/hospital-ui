# TV Legacy Display - Environment Configuration
# Copy this file to .env and configure the values for your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port on which the TV display server will run
# Default: 5500
PORT=5500

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API base URL
# This is the URL of your Hospital Management System backend API
# The TV display will connect to this API for authentication and queue data
# 
# Examples:
#   - Local development: http://localhost:8080
#   - Same network: http://192.168.1.100:8080
#   - Production: https://api.yourhospital.com
#
# Default: http://localhost:8080
API_BASE_URL=http://192.168.1.3:8000

# =============================================================================
# ANNOUNCEMENT / TTS API CONFIGURATION
# =============================================================================

# Base URL for the gTTS Text-to-Speech service
# Used by TV-Legacy to generate patient announcement audio
# POST /api/v1/speech  { text, language: "en"|"hi", slow: false }
#
# Examples:
#   - Local:        http://localhost:9000
#   - Same network: http://192.168.1.13:9000
#
# Leave empty to disable announcement audio generation
TTS_API_URL=

# =============================================================================
# NOTES
# =============================================================================
#
# - When running locally (node server.js), the application will use values
#   from this .env file if it exists
#
# - When running in Docker, these values should be set in docker-compose.yml
#   or passed via -e flags to docker run
#
# - The PORT value should match the port exposed in Docker configuration
#
# - The API_BASE_URL should be accessible from wherever the TV display is running
#
