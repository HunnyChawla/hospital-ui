# TV Legacy Display - Environment Configuration
# Copy this file to .env and configure the values for your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port on which the TV display server will run
# Default: 5500
PORT=5500

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API base URL
# This is the URL of your Hospital Management System backend API
# The TV display will connect to this API for authentication and queue data
# 
# Examples:
#   - Local development: http://localhost:8080
#   - Same network: http://192.168.1.100:8080
#   - Production: https://api.yourhospital.com
#
# Default: http://localhost:8080
API_BASE_URL=http://192.168.1.3:8000

# =============================================================================
# DISPLAY CONFIGURATION
# =============================================================================

# How often the display re-fetches the queues, in seconds.
# Default: 5 — the interval the display polled at before this was configurable.
# TV_REFRESH_SECONDS=5

# The two queue columns, as a JSON array. Leave unset for an eye hospital:
# the built-in defaults are exactly the optometrist and doctor queues this
# display has always shown, so nothing changes.
#
# Set it for any other speciality, pointing the columns at the pathway queue
# and naming that pathway's stages. `key` is the panel position and must stay
# "optometrist" (left) and "doctor" (right). server.js documents every field.
#
# Example for a general hospital with a nurse stage:
#
# TV_COLUMNS=[{"key":"optometrist","title":"Waiting for Nurse","endpoint":"/pathways/queue?stage_codes=awaiting_nurse,nurse_assigned&doctor_id={doctorId}","waiting":["awaiting_nurse"],"active":["nurse_assigned"],"announce":["nurse_assigned"],"announcement":"please proceed to the nurse's room."},{"key":"doctor","title":"Waiting for Doctor","endpoint":"/pathways/queue?stage_codes=awaiting_doctor,doctor_assigned,consultation_in_progress&doctor_id={doctorId}&include_covering_doctors=true","waiting":["awaiting_doctor"],"active":["doctor_assigned","consultation_in_progress"],"inProgress":["consultation_in_progress"],"announce":["doctor_assigned"],"announcement":"your consultation is ready."}]
#
# Invalid JSON here is logged and ignored rather than applied — a bad value
# must never blank a waiting-room screen.

# =============================================================================
# NOTES
# =============================================================================
#
# - When running locally (node server.js), the application will use values
#   from this .env file if it exists
#
# - When running in Docker, these values should be set in docker-compose.yml
#   or passed via -e flags to docker run
#
# - The PORT value should match the port exposed in Docker configuration
#
# - The API_BASE_URL should be accessible from wherever the TV display is running
#
