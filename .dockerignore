# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Note: package-lock.json is NOT ignored - it's required for npm ci

# Next.js build outputs
.next/
out/

# Git
.git/
.gitignore

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files (allow .env.production for Docker builds)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Note: .env.production is NOT ignored - it will be included in the build

# Testing
coverage/
.nyc_output/

# Documentation
*.md
!README.md

# OS files
.DS_Store
Thumbs.db

# Misc
.cache/
.temp/
*.log

